{
	"schemaVersion": 1,
	"id": "arsa",
	"version": "${version}",
	"name": "Arsa",
	"description": "Vanilla-style Enchantment Templates: forge enchanted books into reusable-copy templates and apply enchantments through the smithing table. 附魔模板：铁砧制作、工作台复制、锻造台应用。",
	"authors": [
		"Arsa"
	],
	"license": "Apache-2.0",
	"icon": "assets/arsa/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.Arsa"
		],
		"client": [
			"name.modid.client.ArsaClient"
		],
		"fabric-datagen": [
			"name.modid.client.ArsaDataGenerator"
		]
	},
	"mixins": [
		"arsa.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
}
